{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pearl",
  "version": "../package.json",
  "identifier": "app.pearl.reminders",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pearl",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGNzVCQjQ1OTg3NTUwRTUKUldUbFVIV1lSYnQxbjVzNjNRQ2xaOVNseTAwUVpGcDdMaEU3MGZIRFgyclVsbWFGcVZMZ1hQbm0K",
      "endpoints": [
        "https://github.com/piercedcreased/Pearl/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
